# Managed by Ansible. Do not edit manually.
server {
    listen {{ reverse_proxy_http_port }};
    listen [::]:{{ reverse_proxy_http_port }};
    server_name {{ reverse_proxy_server_name }};

    # Redirect all plain HTTP traffic to HTTPS.
    return 301 https://$host$request_uri;
}

server {
    listen {{ reverse_proxy_https_port }} ssl;
    listen [::]:{{ reverse_proxy_https_port }} ssl;
    server_name {{ reverse_proxy_server_name }};

    ssl_certificate {{ reverse_proxy_tls_cert }};
    ssl_certificate_key {{ reverse_proxy_tls_key }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    auth_basic "{{ reverse_proxy_site_name }}";
    auth_basic_user_file {{ reverse_proxy_htpasswd_file }};

    location / {
        proxy_pass {{ reverse_proxy_backend_url }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
