# Managed by Ansible. Do not edit manually.
groups:
  - name: node-availability
    rules:
      - alert: InstanceDown
        expr: up{job="node"} == 0
        for: {{ prometheus_alert_instance_down_for }}
        labels:
          severity: critical
        annotations:
          summary: "{% raw %}Instance {{ $labels.instance }} is down{% endraw %}"
          description: "{% raw %}{{ $labels.instance }} (job {{ $labels.job }}) has been unreachable for more than the configured duration.{% endraw %}"

  - name: node-resources
    rules:
      - alert: HighCpuUsage
        expr: 100 - (avg by (instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > {{ prometheus_alert_cpu_threshold }}
        for: {{ prometheus_alert_resource_for }}
        labels:
          severity: warning
        annotations:
          summary: "{% raw %}High CPU usage on {{ $labels.instance }}{% endraw %}"
          description: "{% raw %}CPU usage on {{ $labels.instance }} has been above the configured threshold for several minutes.{% endraw %}"

      - alert: HighMemoryUsage
        expr: 100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) > {{ prometheus_alert_memory_threshold }}
        for: {{ prometheus_alert_resource_for }}
        labels:
          severity: warning
        annotations:
          summary: "{% raw %}High memory usage on {{ $labels.instance }}{% endraw %}"
          description: "{% raw %}Memory usage on {{ $labels.instance }} has been above the configured threshold for several minutes.{% endraw %}"

      - alert: LowDiskSpace
        expr: 100 - (node_filesystem_avail_bytes{mountpoint="/"} / node_filesystem_size_bytes{mountpoint="/"} * 100) > {{ prometheus_alert_disk_threshold }}
        for: {{ prometheus_alert_resource_for }}
        labels:
          severity: warning
        annotations:
          summary: "{% raw %}Low disk space on {{ $labels.instance }}{% endraw %}"
          description: "{% raw %}Root filesystem usage on {{ $labels.instance }} has been above the configured threshold for several minutes.{% endraw %}"
